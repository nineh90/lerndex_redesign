{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" }
  },

  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },

    { "src": "/includes/(.*)", "dest": "/api/index.php?page=404" },

    { "src": "/index\\.php", "headers": { "Location": "/" }, "status": 301 },
    { "src": "/([a-z0-9-]+)\\.php", "headers": { "Location": "/$1" }, "status": 301 },
    { "src": "/(.+)/$", "headers": { "Location": "/$1" }, "status": 301 },

    { "src": "/", "dest": "/api/index.php?page=index" },

    { "handle": "filesystem" },

    { "src": "/([a-z0-9-]+)", "dest": "/api/index.php?page=$1" },
    { "src": "/(.*)", "dest": "/api/index.php?page=404" }
  ]
}
