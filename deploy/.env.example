# Vorlage fuer /docker/lerndex/deploy/.env auf dem VPS.
# Die echte .env steht NIE im Repository (es ist oeffentlich).

# ── Adresse ─────────────────────────────────────────────────────
# Standard ist lerndex.de + www.lerndex.de – die Zeilen koennen leer bleiben.
# Hier darf nur stehen, was im DNS auf diesen Server zeigt (sonst scheitert
# das Zertifikat, und Let's Encrypt sperrt den Namen voruebergehend).
#
# Optionale Testadresse mit noindex, z. B.:
#   LERNDEX_REGEL=Host(`test.lerndex.de`)
#   LERNDEX_MIDDLEWARES=lerndex-vorschau@docker
#   LERNDEX_PRUEFHOST=test.lerndex.de
#   LERNDEX_MODUS=vorschau

# ── Formulare → n8n ─────────────────────────────────────────────
# Interne Adresse im Docker-Netz, NICHT die oeffentliche n8n-Domain.
N8N_CONTACT=http://n8n:5678/webhook/lerndex-formulare
N8N_SUPPORT=
N8N_TOKEN=
